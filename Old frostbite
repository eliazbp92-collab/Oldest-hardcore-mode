game.ReplicatedStorage.GameData.LatestRoom.Changed:Wait()


local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local plr = Players.LocalPlayer
local chr = plr.Character or plr.CharacterAdded:Wait()

-- Hàm lấy phòng hiện tại an toàn
local function GetRoom()
	local currentRooms = workspace:WaitForChild("CurrentRooms", 10)
	local latestRoomValue = ReplicatedStorage:WaitForChild("GameData"):WaitForChild("LatestRoom").Value
	if currentRooms then
		return currentRooms:FindFirstChild(latestRoomValue)
	end
	return nil
end

local currentRoom = GetRoom()
if not currentRoom then
	warn("Không tìm thấy phòng hiện tại!")
	return
end

-- 🔽 Tải Frost entity từ Roblox Asset
local success, objects = pcall(function()
	return game:GetObjects("rbxassetid://16705676239")
end)

if not success or not objects or #objects == 0 then
	warn("Không thể tải Frost entity (GetObjects thất bại hoặc ID không hợp lệ).")
	return
end

local s = objects[1]
s.Parent = workspace -- ⚠️ Đã sửa: Bắt buộc parent vào workspace để hiển thị Entity

local entity = s:FindFirstChildWhichIsA("BasePart") or s:FindFirstChild("Part") or s
if not entity then
	warn("Không tìm thấy BasePart trong Entity!")
	return
end

-- Đặt vị trí xuất hiện ở lối vào phòng
local roomEntrance = currentRoom:WaitForChild("RoomEntrance", 5)
if roomEntrance then
	if entity:IsA("BasePart") then
		entity.CFrame = roomEntrance.CFrame * CFrame.new(0, -5, -15)
	elseif entity:IsA("Model") then
		entity:PivotTo(roomEntrance.CFrame * CFrame.new(0, -5, -15))
	end
end

-- Kiểm tra an toàn cho Part phụ nếu có
if entity:FindFirstChild("Part") then
	entity.Part.CFrame = entity.CFrame
end

-- Tắt âm thanh mặc định nếu đang chạy
if entity:FindFirstChild("Ambience") then pcall(function() entity.Ambience:Stop() end) end
if entity:FindFirstChild("AmbienceFar") then pcall(function() entity.AmbienceFar:Stop() end) end

entity.Ambience.SoundId = "rbxassetid://1102548016"
entity.Ambience.SoundId = "rbxassetid://1102548016"

-- 💡 Ánh sáng xuất hiện (Sửa Color3 & Brightness Tween)
local pointLight = Instance.new("PointLight")
pointLight.Color = Color3.fromRGB(255, 255, 255)
pointLight.Range = 60
pointLight.Brightness = 0
pointLight.Parent = entity

-- Tween ánh sáng từ 0 lên 3
TweenService:Create(pointLight, TweenInfo.new(3), {Brightness = 3}):Play()

-- 🎵 Âm thanh xuất hiện
local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://137044859218769"
sound.Looped = false
sound.Volume = 5
sound.Parent = entity
sound:Play()

-- ❄️ Hiệu ứng lạnh màn hình (Màu xanh lạnh dịu mắt hơn)
local frost = Instance.new("ColorCorrectionEffect")
frost.Parent = game:GetService("Lighting")
TweenService:Create(frost, TweenInfo.new(10), {
	TintColor = Color3.fromRGB(0, 0, 255),
	Saturation = -0.5,
	Contrast = 0.2
}):Play()

-- ❌ Tắt hiệu ứng ban đầu trong Attachment
local attachment = entity:FindFirstChild("Attachment")
if attachment then
	for _, v in ipairs({"face", "Heylois", "BlackTrai2l", "BlackTrai3l"}) do
		local child = attachment:FindFirstChild(v)
		if child then
			child.Enabled = false
		end
	end
end

task.wait(8)

-- ✅ Bật lại tất cả hiệu ứng (Attachment + Particle)
if attachment then
	for _, v in ipairs({"face", "Heylois", "BlackTrai2l", "BlackTrai3l"}) do
		local child = attachment:FindFirstChild(v)
		if child then
			child.Enabled = true
		end
	end
end

-- Bật tất cả particle trong Frostbite > FrostyNew > part
local frostbiteModel = s:FindFirstChild("Frostbite")
if frostbiteModel then
	local frostyNew = frostbiteModel:FindFirstChild("FrostyNew")
	if frostyNew then
		local frostPart = frostyNew:FindFirstChild("part")
		if frostPart then
			for _, particle in ipairs(frostPart:GetDescendants()) do
				if particle:IsA("ParticleEmitter") then
					particle.Enabled = true
				end
			end
		end
	end
end

-- 🎵 Phát âm thanh ambience
if entity:FindFirstChild("Ambience") then pcall(function() entity.Ambience:Play() end) end
if entity:FindFirstChild("AmbienceFar") then pcall(function() entity.AmbienceFar:Play() end) end

-- 🔥 Gây sát thương nếu không có bật lửa (Sửa: Kiểm tra cả trong Backpack)
local dmg = true
task.spawn(function()
	while dmg do
		task.wait(1)
		chr = plr.Character or plr.CharacterAdded:Wait()

		local lighterInHand = chr:FindFirstChild("Lighter")
		local lighterInBackpack = plr.Backpack and plr.Backpack:FindFirstChild("Lighter")

		-- Nếu không cầm trên tay VÀ cũng không có trong túi đồ
		if not lighterInHand and not lighterInBackpack then
			pcall(function()
				local hum = chr:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					hum:TakeDamage(3)

					local stats = ReplicatedStorage:FindFirstChild("GameStats")
					if stats and stats:FindFirstChild("Player_" .. plr.Name) then
						stats["Player_" .. plr.Name].Total.DeathCause.Value = "Frostbite"
					end
				end
			end)
		end
	end
end)

-- 🛑 Khi chuyển sang phòng tiếp theo -> Dừng hiệu ứng & dọn dẹp
local latestRoom = ReplicatedStorage.GameData.LatestRoom
local changedConnection
changedConnection = latestRoom.Changed:Connect(function()
	dmg = false
	changedConnection:Disconnect()

	-- Tắt các hiệu ứng khi rời phòng
	if attachment then
		for _, v in ipairs({"face", "Heylois", "BlackTrai2l", "BlackTrai3l"}) do
			local child = attachment:FindFirstChild(v)
			if child then
				child.Enabled = false
			end
		end
	end

	if frostbiteModel then
		local frostyNew = frostbiteModel:FindFirstChild("FrostyNew")
		if frostyNew then
			local frostPart = frostyNew:FindFirstChild("part")
			if frostPart then
				for _, particle in ipairs(frostPart:GetDescendants()) do
					if particle:IsA("ParticleEmitter") then
						particle.Enabled = false
					end
				end
			end
		end
	end

	-- Âm thanh dừng và biến mất
	if entity:FindFirstChild("Ambience") then pcall(function() entity.Ambience:Stop() end) end
	if entity:FindFirstChild("AmbienceFar") then pcall(function() entity.AmbienceFar:Stop() end) end

	local des = Instance.new("Sound")
	des.SoundId = "rbxassetid://111715441853991"
	des.Looped = false
	des.Volume = 2.5
	des.Parent = workspace
	des:Play()

	task.wait(5)
	if s then s:Destroy() end

	-- 🌈 Hoàn tác hiệu ứng lạnh
	TweenService:Create(frost, TweenInfo.new(5), {
		TintColor = Color3.fromRGB(255, 255, 255),
		Saturation = 0,
		Contrast = 0
	}):Play()

	task.wait(5)
	if frost then frost:Destroy() end
end)
