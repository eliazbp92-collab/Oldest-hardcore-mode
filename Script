entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
	if not firstTime then
		print("Entity has entered room: " .. room.Name .. " again")
		return
	end

	local chance = rng:NextInteger(93, 100)
	if chance == 100 then
		task.wait(rng:NextNumber(0.5, 1))

		local Roomec = room:FindFirstChild("RoomEntrance", true)
		local entityModel = entity.Model or workspace:FindFirstChild("CeaseMoving")
		local entityRoot = entityModel and (entityModel:FindFirstChild("HumanoidRootPart") or entityModel:FindFirstChildWhichIsA("BasePart"))

		if entityModel then
			local move = GetGitSound("https://github.com/eoyoustme/Custom-Entity/blob/main/TAILOC.mp3?raw=true","tailocdeolon")
			move.Parent = workspace
			move.Name = "tailoc"
			move.Volume = 3
			move:Play()
			move.Ended:Connect(function() move:Destroy() end)
		end

		if entityModel and entityModel.Parent and entityRoot then
			local doorFreezePos = entityRoot.CFrame
			local freezeConnection

			freezeConnection = RunService.Heartbeat:Connect(function()
				if entityModel and entityModel.Parent and entityRoot then
					entityRoot.Anchored = true
					entityRoot.CFrame = doorFreezePos
					entityRoot.AssemblyLinearVelocity = Vector3.zero
					entityRoot.AssemblyAngularVelocity = Vector3.zero
				end
			end)

			task.wait(3)

			if freezeConnection then
				freezeConnection:Disconnect()
				freezeConnection = nil
			end

			entityRoot.Anchored = true

			local tweenDown = Tweenservice:Create(
				entityRoot,
				TweenInfo.new(0.75, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
				{ CFrame = Roomec.CFrame * CFrame.new(0, -1, 0) }
			)

			tweenDown:Play()
			tweenDown.Completed:Wait()
		end
	end
end)


